#!/bin/bash
# theme-switch green|rabbit|status|patch|test
#   green  = ~/green-hyprtheme   (attuale)
#   rabbit = ~/my-dotfiles       (WhiteRabbitShell, con patch NVIDIA/Intel)
#   test   = da tty2: passa a rabbit, avvia Hyprland, al termine torna a green
set -eu
GREEN="$HOME/green-hyprtheme"
RABBIT="$HOME/my-dotfiles"
HYPR="$HOME/.config/hypr"
QS="$HOME/.config/quickshell"

# Intel iGPU (vendor 0x8086) → /dev/dri/cardN. L'indice cambia tra boot: MAI hardcodare.
# NVIDIA (0x10de) non ha CRTC su questo laptop → puntarla = kernel hang.
intel_card() {
    for c in /sys/class/drm/card[0-9]; do
        [ "$(cat "$c/device/vendor" 2>/dev/null)" = "0x8086" ] && { echo "/dev/dri/$(basename "$c")"; return 0; }
    done
    return 1
}

patch_rabbit() {
    local f="$RABBIT/hyprland.lua"
    [ -f "$f" ] || { echo "manca $f"; exit 1; }
    python3 - "$f" <<'PY'
import sys,re
p=sys.argv[1]; s=open(p).read()
if "-- [green-patch]" not in s:
    # 1. sostituisce il blocco NVIDIA di upstream (GBM_BACKEND=nvidia-drm + LIBVA nvidia)
    pat=re.compile(r'-- NVIDIA \(solo se il driver.*?\nend\n', re.S)
    new='''-- [green-patch] GPU: Intel UHD 770 per il display, NVIDIA A2000 solo compute (nessun CRTC).
-- AQ_DRM_DEVICES va impostato PRIMA di Hyprland (lo fa `theme-switch test`/launcher);
-- qui è solo un fallback dinamico, l'indice cardN cambia tra boot. MAI puntare NVIDIA (kernel hang).
if not os.getenv("AQ_DRM_DEVICES") then
    for i = 0, 3 do
        local v = io.open("/sys/class/drm/card" .. i .. "/device/vendor", "r")
        if v then
            local id = v:read("*l"); v:close()
            if id == "0x8086" then hl.env("AQ_DRM_DEVICES", "/dev/dri/card" .. i); break end
        end
    end
end
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("WLR_NO_HARDWARE_CURSORS", "1")
-- niente GBM_BACKEND=nvidia-drm, niente LIBVA_DRIVER_NAME=nvidia (rotto su questo hardware)
'''
    s,n=pat.subn(new,s,count=1)
    if n!=1: sys.exit("blocco NVIDIA non trovato: upstream cambiato, patch manuale")
    open(p,'w').write(s); print("hyprland.lua patchato (NVIDIA)")
else:
    print("hyprland.lua: patch NVIDIA già presente")
PY
    # remap muscle-memory green: SUPER+W=close (era K), SUPER+CTRL+W=wallpaper (era W), SUPER+Q=launcher alias
    if ! grep -q "green-patch-remap" "$f"; then
        python3 - "$f" <<'PY'
import sys
p=sys.argv[1]; s=open(p).read()
s=s.replace(
    'hl.bind(mainMod .. " + W",              shell("wallpaper"))',
    '-- [green-patch-remap] W->close (era K), wallpaper->CTRL+W (era W), Q alias launcher\nhl.bind(mainMod .. " + CTRL + W",       shell("wallpaper"))',
    1)
s=s.replace(
    'hl.bind(mainMod .. " + K",         hl.dsp.window.close())',
    'hl.bind(mainMod .. " + W",         hl.dsp.window.close())',
    1)
s=s.replace(
    'hl.bind(mainMod .. " + D",              shell("launcher"))',
    'hl.bind(mainMod .. " + D",              shell("launcher"))\nhl.bind(mainMod .. " + Q",              shell("launcher"))',
    1)
open(p,'w').write(s)
print("hyprland.lua: remap W/K/Q applicato")
PY
    fi
    # monitors.lua (non versionato, specifico macchina)
    if [ ! -f "$RABBIT/monitors.lua" ] && [ -f "$GREEN/monitors.lua" ]; then
        cp "$GREEN/monitors.lua" "$RABBIT/monitors.lua"; echo "monitors.lua copiato"
    fi
    # hibernate a batteria <=5% senza AC (stesso helper del green)
    if ! grep -q idle-hibernate-check "$RABBIT/hypridle.conf"; then
        cat >> "$RABBIT/hypridle.conf" <<'HI'

listener {
    timeout = 600
    on-timeout = $HOME/.local/bin/idle-hibernate-check.sh  # iberna solo se no AC e batteria <=5%
}
HI
        echo "hypridle.conf: aggiunto idle-hibernate"
    fi
    # kb_layout: rabbit upstream usa "us", io voglio "it"
    if grep -q 'kb_layout     = "us"' "$f"; then
        sed -i 's/kb_layout     = "us"/kb_layout     = "it"/' "$f"
        echo "hyprland.lua: kb_layout -> it"
    fi
    # N=night mode come green (notifiche/dnd rabbit spostate su CTRL+N / CTRL+SHIFT+N)
    if ! grep -q "green-patch-night" "$f"; then
        python3 - "$f" <<'PY'
import sys
p=sys.argv[1]; s=open(p).read()
s=s.replace(
    'hl.bind(mainMod .. " + N",              shell("notifications"))\nhl.bind(mainMod .. " + SHIFT + N",      shell("dnd"))',
    '-- [green-patch-night] N->night mode (come green), notifiche/dnd su CTRL\n'
    'hl.bind(mainMod .. " + N",              hl.dsp.exec_cmd("bash -c \'pkill hyprsunset; hyprsunset -t 4500 &\'"))\n'
    'hl.bind(mainMod .. " + SHIFT + N",      hl.dsp.exec_cmd("pkill hyprsunset || true"))\n'
    'hl.bind(mainMod .. " + CTRL + N",       shell("notifications"))\n'
    'hl.bind(mainMod .. " + CTRL + SHIFT + N", shell("dnd"))',
    1)
open(p,'w').write(s); print("hyprland.lua: N=night mode applicato")
PY
    fi
    # binds del green mancanti in rabbit (scratchpad, lock, zoom-reset, cheatsheet)
    if ! grep -q "green-patch-binds" "$RABBIT/hyprland.lua"; then
        cat >> "$RABBIT/hyprland.lua" <<'BINDS'

-- [green-patch-binds] portati da green-hyprtheme/keybindings.lua
-- F1/Print/SHIFT+Print/CTRL+L: rabbit ha già il suo bind nativo con stesso risultato (screenshot/lock), non duplicare
hl.bind(mainMod .. " + F12", hl.dsp.exec_cmd("bash $HOME/green-hyprtheme/rofi/scripts/rofi-scratchpad.sh"))
hl.bind(mainMod .. " + F9", hl.dsp.exec_cmd("~/.local/bin/zoom-share-reset"))
hl.bind(mainMod .. " + SHIFT + L", function() hl.clear_crashed_lockscreen() end)
-- night mode: vedi SUPER+N / SUPER+SHIFT+N nella sezione Shell (come green-hyprtheme)
hl.bind(mainMod .. " + F2", hl.dsp.exec_cmd("bash $HOME/green-hyprtheme/rofi/scripts/rofi-cheatsheet.sh"))
BINDS
        echo "hyprland.lua: aggiunti bind green mancanti (F12/F9/F2/SHIFT+L)"
    fi
    # risolve conflitti residui: SUPER+P (green=hyprpicker, rabbit=pin) e SUPER+A (green=pavucontrol, rabbit=shell control)
    if ! grep -q "green-patch-swap" "$f"; then
        python3 - "$f" <<'PY'
import sys
p=sys.argv[1]; s=open(p).read()
s=s.replace(
    'hl.bind(mainMod .. " + P",         hl.dsp.window.pin())',
    '-- [green-patch-swap] P<->SHIFT+P: P=hyprpicker (green), pin spostato su SHIFT+P\nhl.bind(mainMod .. " + SHIFT + P", hl.dsp.window.pin())',
    1)
s=s.replace(
    'hl.bind(mainMod .. " + SHIFT + P",  hl.dsp.exec_cmd("hyprpicker -a"))',
    'hl.bind(mainMod .. " + P",         hl.dsp.exec_cmd("hyprpicker -a"))',
    1)
s=s.replace(
    'hl.bind(mainMod .. " + A",              shell("control"))',
    'hl.bind(mainMod .. " + CTRL + A",       shell("control"))\nhl.bind(mainMod .. " + A",              hl.dsp.exec_cmd("pavucontrol"))',
    1)
open(p,'w').write(s)
print("hyprland.lua: swap P/SHIFT+P e A/CTRL+A applicato")
PY
    fi
    # dolphin & altre app Qt6 nere: upstream mette QT_QPA_PLATFORMTHEME=qt5ct,
    # ma qt5ct NON tematizza le app Qt6 (dolphin 26.x = Qt6) -> fallback Breeze chiaro ("righe bianche").
    # qt6ct c'è già con GlassyGreen dark. Forzo qt6ct.
    if grep -q 'hl.env("QT_QPA_PLATFORMTHEME", "qt5ct")' "$f"; then
        sed -i 's#hl.env("QT_QPA_PLATFORMTHEME", "qt5ct")#hl.env("QT_QPA_PLATFORMTHEME", "qt6ct") -- [green-patch-qt6] dolphin/app Qt6 dark#' "$f"
        echo "hyprland.lua: QT_QPA_PLATFORMTHEME -> qt6ct (fix dolphin dark)"
    fi
    # SUPER+Space = ricerca file fsearch (stile Spotlight/Finder, come green). NON il launcher app.
    if ! grep -q "green-patch-space" "$f"; then
        python3 - "$f" <<'PY'
import sys
p=sys.argv[1]; s=open(p).read()
s=s.replace(
    'hl.bind("grave",                        shell("launcher"))',
    'hl.bind("grave",                        shell("launcher"))\n'
    'hl.bind(mainMod .. " + SPACE",          hl.dsp.exec_cmd("env GTK_THEME=Adwaita:dark fsearch")) -- [green-patch-space] ricerca file',
    1)
open(p,'w').write(s); print("hyprland.lua: SUPER+SPACE = fsearch (ricerca file)")
PY
    fi
    # SUPER+SHIFT+Space = recoll (full-text: cerca DENTRO i documenti ~/Documents)
    if ! grep -q "green-patch-recoll" "$f"; then
        python3 - "$f" <<'PY'
import sys
p=sys.argv[1]; s=open(p).read()
s=s.replace(
    'hl.bind(mainMod .. " + SPACE",          hl.dsp.exec_cmd("env GTK_THEME=Adwaita:dark fsearch")) -- [green-patch-space] ricerca file',
    'hl.bind(mainMod .. " + SPACE",          hl.dsp.exec_cmd("env GTK_THEME=Adwaita:dark fsearch")) -- [green-patch-space] ricerca file\n'
    'hl.bind(mainMod .. " + SHIFT + SPACE",  hl.dsp.exec_cmd("recoll")) -- [green-patch-recoll] full-text documenti',
    1)
open(p,'w').write(s); print("hyprland.lua: SUPER+SHIFT+SPACE = recoll (full-text)")
PY
    fi
    patch_launcher_filesearch
}

# [green-patch-filesearch] integra ricerca file nel launcher quickshell di rabbit:
#   "/" = file per nome (fd)   "//" = full-text nei documenti (recoll)
# Patch idempotente su shell/modules/launcher/Launcher.qml (file versionato upstream -> dotup lo ripristina).
patch_launcher_filesearch() {
    # Applica ricerca-file nel launcher + tab "Ricerca" nelle impostazioni.
    # Un solo patch-diff (green-setup/patches/search-tab.patch) invece di decine di string-replace:
    # tocca shell/{config/Settings.qml, modules/launcher/Launcher.qml, modules/settings/SettingsPanel.qml}.
    local P="$RABBIT/green-setup/patches/search-tab.patch"
    local L="$RABBIT/shell/modules/launcher/Launcher.qml"
    [ -f "$L" ] || { echo "launcher: $L assente, salto"; return 0; }
    if grep -q "searchExcludes" "$L" 2>/dev/null; then
        echo "launcher+tab ricerca: già presenti"
        return 0
    fi
    [ -f "$P" ] || { echo "launcher: patch $P assente, salto (ricerca file non applicata)"; return 0; }
    if git -C "$RABBIT" apply --check "$P" 2>/dev/null; then
        git -C "$RABBIT" apply "$P" && echo "launcher+tab ricerca: patch applicata (/ fd, // recoll, tab Impostazioni)"
    else
        echo "!! launcher: la patch ricerca NON si applica pulita (upstream Launcher/Settings cambiato?)."
        echo "   Rigenera: cd $RABBIT && git diff shell/config/Settings.qml shell/modules/launcher/Launcher.qml shell/modules/settings/SettingsPanel.qml > green-setup/patches/search-tab.patch"
    fi
}

link_to() {
    local target="$1"
    if [ -e "$HYPR" ] && [ ! -L "$HYPR" ]; then echo "$HYPR non è un symlink, stop"; exit 1; fi
    ln -sfn "$target" "$HYPR"
    if [ "$target" = "$RABBIT" ]; then ln -sfn "$HYPR/shell" "$QS"; else rm -f "$QS"; fi
    echo "~/.config/hypr → $(readlink "$HYPR")"
}

# ammazza qualunque bar quickshell (green "quickshell --path ..." o rabbit "qs -p ...")
# prima di toccare il symlink ~/.config/hypr: altrimenti un riavvio bar in corso
# può risolvere il path quickshell/shell DOPO il relink e aprire il tema sbagliato.
kill_shell() {
    pkill -9 -f "quickshell --path" 2>/dev/null || true
    pkill -9 -f "^qs -p " 2>/dev/null || true
    pkill -9 -x quickshell 2>/dev/null || true
    pkill -9 -x qs 2>/dev/null || true
    sleep 0.4
}

restart_shell() {
    local target="$1"
    # sfondo vecchio sopravvive al relink (path cambia sotto di lui, sfondo non si aggiorna)
    pkill -9 -x swaybg 2>/dev/null || true
    pkill -9 -x hyprpaper 2>/dev/null || true
    pkill -9 -x awww-daemon 2>/dev/null || true
    pkill -9 -x conky 2>/dev/null || true
    if [ "$target" = "$RABBIT" ]; then
        # rabbit ha il suo sistema notifiche nativo (QML, pannello impostazioni ->
        # "Durata popup"): swaync di green resterebbe acceso in parallelo, doppioni.
        systemctl --user stop swaync.service 2>/dev/null || true
        nohup qs -p "$HYPR/shell" >/dev/null 2>&1 &
        disown
        # rabbit usa awww (daemon + transizioni animate, pilotato dal picker nativo SUPER+CTRL+W)
        nohup awww-daemon >/dev/null 2>&1 &
        disown
        sleep 0.4
        local wp="$(python3 -c "import json;print(json.load(open('$RABBIT/settings.json'))['wallpaper'])" 2>/dev/null)"
        [ -f "$wp" ] || wp="$HYPR/wallpapers/wallpaper.jpg"
        nohup awww img "$wp" --transition-type fade >/dev/null 2>&1 &
    else
        systemctl --user start swaync.service 2>/dev/null || true
        nohup env QT_ICON_THEME=Papirus-Dark quickshell --path "$HYPR/quickshell/shell.qml" >/dev/null 2>&1 &
        disown
        nohup conky -c "$HYPR/conky/cyberconky-left.conf" >/dev/null 2>&1 &
        disown
        nohup conky -c "$HYPR/conky/cyberconky-right.conf" >/dev/null 2>&1 &
        disown
        nohup swaybg -i "$HYPR/wallpaper/wallpaper.jpg" -m fill >/dev/null 2>&1 &
    fi
    disown
}

case "${1:-status}" in
    status) echo "hypr → $(readlink "$HYPR")"; echo "intel: $(intel_card || echo NON TROVATA)"; grep -c green-patch "$RABBIT/hyprland.lua" | sed 's/^/patch rabbit: /' ;;
    patch)  patch_rabbit ;;
    green)  kill_shell; link_to "$GREEN"; hyprctl reload >/dev/null 2>&1 || true; restart_shell "$GREEN"; echo "ok: bar green riavviata" ;;
    rabbit) patch_rabbit; kill_shell; link_to "$RABBIT"; hyprctl reload >/dev/null 2>&1 || true; restart_shell "$RABBIT"; echo "ok: bar rabbit riavviata" ;;
    test)
        [ -z "${WAYLAND_DISPLAY:-}" ] || { echo "lancia da un TTY (tty2), non dentro Wayland"; exit 1; }
        AQ="$(intel_card)" || { echo "Intel non trovata, stop"; exit 1; }
        patch_rabbit
        trap 'link_to "$GREEN"' EXIT
        link_to "$RABBIT"
        export AQ_DRM_DEVICES="$AQ" XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland
        echo "AQ_DRM_DEVICES=$AQ — avvio Hyprland (rabbit). Uscita: SUPER+M o logout → torna green."
        start-hyprland || Hyprland
        ;;
    *) echo "uso: theme-switch green|rabbit|status|patch|test"; exit 1 ;;
esac
