+                const isDir = p.endsWith("/");
+                const clean = isDir ? p.slice(0, -1) : p;
+                const name = clean.split("/").pop();
+                return { name: name, path: clean, isFile: true, isDir: isDir };
+            });
+            list.currentIndex = 0;
+        }, 120, 8000, root);
+    }
+
